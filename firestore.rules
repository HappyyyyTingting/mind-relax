rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /entries/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /talk_messages/{id} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /user_config/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid;
      allow update, delete: if signedIn() && uid == request.auth.uid;
    }
  }
}
